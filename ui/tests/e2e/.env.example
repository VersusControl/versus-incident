# =============================================================================
# Browser e2e (Playwright) — versus-incident (OSS) admin SPA
# Copy to `.env` (gitignored) and fill in. These drive a REAL running OSS
# instance like an operator. Review-first: read the README + the specs before
# running against any instance.
# =============================================================================

# Only needed when running without harness-run (`harness.sh e2e ui` sets these).
# Origin the browser hits: the running instance's public origin.
E2E_BASE_URL=http://localhost:8080

# OSS: must equal the running server's GATEWAY_SECRET. Never a production secret.
E2E_GATEWAY_SECRET=

# Licensed Enterprise: the built-in admin printed once in the first-boot banner.
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=

# Run headed locally (true) or headless for CI/unattended (unset/false).
E2E_HEADFUL=false
