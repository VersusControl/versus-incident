# =============================================================================
# Browser e2e (Playwright) — versus-incident (OSS) admin SPA
# Copy to `.env` (gitignored) and fill in. These drive a REAL running OSS
# instance like an operator. Review-first: read the README + the specs before
# running against any instance.
# =============================================================================

# Origin the browser hits. MUST be the running OSS instance's public origin.
# The OSS binary serves the embedded SPA on :8080 by default; the run/ harness
# maps it to 127.0.0.1:${OSS_PORT:-8080}.
E2E_BASE_URL=http://localhost:8080

# The OSS single-admin GATEWAY SECRET. MUST equal the running server's
# GATEWAY_SECRET (config `gateway_secret: ${GATEWAY_SECRET}`). The SPA
# exchanges it once for an HttpOnly session cookie. The run/ harness default is `dev-gateway-secret`
# (run/env/shared.env). Never a production secret.
E2E_GATEWAY_SECRET=dev-gateway-secret

# Run headed locally (true) or headless for CI/unattended (unset/false).
E2E_HEADFUL=false
