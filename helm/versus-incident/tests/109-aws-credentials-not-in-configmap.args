# The quickstart values with only the ConfigMap rendered: neither the Secret
# nor its key names may appear in the config files.
--set
connectors.aws.enable=true
--set
connectors.aws.credentials.existingSecret=versus-aws
--set
connectors.aws.accounts[0].accountId=111122223333
--set
connectors.aws.accounts[0].regions[0]=us-east-1
--show-only
templates/configmap.yaml
