# Credentials reach tools.yaml only through env indirection.
token: "\$\{GIT_AUTH_TOKEN\}"
token: "\$\{GIT_AUTH_TOKEN_1\}"
!token: "\$\{KUBERNETES_TOKEN\}"
ca_data: "\$\{KUBERNETES_CA_DATA\}"
client_secret: "\$\{KUBERNETES_AKS_CLIENT_SECRET\}"

# ...and are present in the Secret.
git_auth_token:
git_auth_token_1:
kubernetes_token:
kubernetes_ca_data:
kubernetes_aks_client_secret:

# ...and are injected into the container.
- name: GIT_AUTH_TOKEN
- name: GIT_AUTH_TOKEN_1
- name: KUBERNETES_TOKEN
- name: KUBERNETES_CA_DATA
- name: KUBERNETES_AKS_CLIENT_SECRET

# Non-secret tool data still renders in the ConfigMap.
endpoint: "https://10.20.30.40:6443"
credential_mode: "client_secret"
server_id: "api://aks-server"
environment: "government"
!federated_token_file: "/var/run/secrets/azure/tokens/identity-token"
!cluster_name: "production"
!role_arn: "arn:aws:iam::123456789012:role/reader"
!credentials_file: "/var/run/secrets/google/credentials.json"
kind: ClusterRole
kind: ClusterRoleBinding
resources: \["nodes", "namespaces", "pods", "services", "events", "configmaps", "persistentvolumeclaims", "persistentvolumes"\]
resources: \["pods/log"\]
resources: \["endpointslices"\]
resources: \["customresourcedefinitions"\]
!resources: \["endpoints"\]
!resources: \["secrets"\]
url: "https://github.com/acme/api.git"

# No credential may appear as a literal anywhere in the rendered manifests.
!ghp-global-literal-token
!ghp-per-repo-literal-token
!kube-literal-token
!kube-ca-literal-data
!aks-literal-client-secret
!exec_timeout
!login_mode
