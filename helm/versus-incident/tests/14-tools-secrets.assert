# Credentials reach tools.yaml only through env indirection.
token: "\$\{GIT_AUTH_TOKEN\}"
token: "\$\{GIT_AUTH_TOKEN_1\}"
bearer_token: "\$\{QUERY_METRICS_PROMETHEUS_BEARER_TOKEN\}"
password: "\$\{QUERY_METRICS_PROMETHEUS_PASSWORD\}"
bearer_token: "\$\{QUERY_TRACES_TEMPO_BEARER_TOKEN\}"
password: "\$\{QUERY_TRACES_TEMPO_PASSWORD\}"

# ...and are present in the Secret.
git_auth_token:
git_auth_token_1:
query_metrics_prometheus_bearer_token:
query_metrics_prometheus_password:
query_traces_tempo_bearer_token:
query_traces_tempo_password:

# ...and are injected into the container.
- name: GIT_AUTH_TOKEN
- name: GIT_AUTH_TOKEN_1
- name: QUERY_METRICS_PROMETHEUS_BEARER_TOKEN
- name: QUERY_METRICS_PROMETHEUS_PASSWORD
- name: QUERY_TRACES_TEMPO_BEARER_TOKEN
- name: QUERY_TRACES_TEMPO_PASSWORD

# Non-secret tool data still renders in the ConfigMap.
address: "http://prometheus:9090"
address: "http://tempo:3200"
username: "prom-user"
username: "tempo-user"
url: "https://github.com/acme/api.git"

# No credential may appear as a literal anywhere in the rendered manifests.
!ghp-global-literal-token
!ghp-per-repo-literal-token
!prom-literal-bearer
!prom-literal-password
!tempo-literal-bearer
!tempo-literal-password
