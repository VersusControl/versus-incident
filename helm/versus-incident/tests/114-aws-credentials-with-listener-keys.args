# The SNS listener's own literal AWS keys plus the connector's Secret: both
# would set AWS_ACCESS_KEY_ID on the same container.
--set
alert.sns.enable=true
--set
aws.accessKeyId=example-key-id
--set
aws.secretAccessKey=example-secret-only
--set
connectors.aws.enable=true
--set
connectors.aws.credentials.existingSecret=versus-aws
