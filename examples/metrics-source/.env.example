# Optional: copy to `.env` to keep your settings between runs. `.env` is
# gitignored; never commit a real license key.
#   cp .env.example .env

# Enterprise license. The Prometheus and traces sources need it; without it
# the image runs in community mode and the sources stay off.
LICENSE_KEY=

# Enterprise image. Override to pin a tag or use a locally built image.
VERSUS_ENTERPRISE_IMAGE=ghcr.io/versuscontrol/versus-enterprise

# Protects the admin API only in community mode (no license). Licensed, you
# sign in as the built-in admin whose password is printed once in the logs.
GATEWAY_SECRET=change-me

POSTGRES_PASSWORD=versus-dev
REDIS_PASSWORD=versus

# training | shadow | detect
AGENT_MODE=detect

# Optional: AI analysis. The sources learn and detect without it.
AGENT_AI_ENABLE=false
AGENT_AI_API_KEY=
AGENT_AI_MODEL=gpt-4o-mini

# Optional: notifications.
SLACK_ENABLE=false
SLACK_TOKEN=
SLACK_CHANNEL_ID=
TELEGRAM_ENABLE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
