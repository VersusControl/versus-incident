# Settings for examples/aws/eks. Copy to setup.env, replace every <...> value,
# then load it in each new terminal:
#
#   set -a; . ./setup.env; set +a
#
# No secrets go in this file. The external ID is created in the terminal and
# stored in a Kubernetes Secret (see the guide).

# The EKS cluster where Versus runs, and the account that owns it.
# The Versus IAM role, versus-app, is created in this account.
AWS_REGION="<us-east-1>"
CLUSTER_NAME="<your-eks-cluster>"
VERSUS_ACCOUNT_ID="<12-digit account ID of the cluster>"

# Where Versus is installed. The trust policies name this exact ServiceAccount.
NAMESPACE="versus"
SERVICE_ACCOUNT="versus-incident"

# Path to the Helm chart in your copy of the repository (dev branch).
CHART="<path to versus-incident>/helm/versus-incident"

# Several accounts: the accounts Versus reads through versus-reader, and the
# AWS CLI profile that signs in to each one.
PROD_ACCOUNT_ID="<12-digit Production account ID>"
PROD_PROFILE="<aws cli profile for Production>"
STAGING_ACCOUNT_ID="<12-digit Staging account ID>"
STAGING_PROFILE="<aws cli profile for Staging>"

# FinOps for an AWS Organization: the management (payer) account, which holds
# versus-cost-reader.
MGMT_ACCOUNT_ID="<12-digit management account ID>"
MGMT_PROFILE="<aws cli profile for the management account>"
