{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CostReads",
      "Effect": "Allow",
      "Resource": "*",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:GetCostAndUsageWithResources",
        "ce:GetCostForecast",
        "ce:GetSavingsPlansCoverage",
        "ce:ListCostAllocationTags",
        "budgets:ViewBudget",
        "cost-optimization-hub:ListRecommendations",
        "compute-optimizer:GetEC2InstanceRecommendations"
      ]
    },
    {
      "Sid": "DenyEverythingButCostReads",
      "Effect": "Deny",
      "Resource": "*",
      "NotAction": [
        "ce:GetCostAndUsage",
        "ce:GetCostAndUsageWithResources",
        "ce:GetCostForecast",
        "ce:GetSavingsPlansCoverage",
        "ce:ListCostAllocationTags",
        "budgets:ViewBudget",
        "cost-optimization-hub:ListRecommendations",
        "compute-optimizer:GetEC2InstanceRecommendations"
      ]
    },
    {
      "Sid": "DenyBillingAccountSurfaces",
      "Effect": "Deny",
      "Resource": "*",
      "Action": [
        "account:*",
        "aws-portal:*",
        "billing:*",
        "consolidatedbilling:*",
        "invoicing:*",
        "payments:*",
        "purchase-orders:*",
        "tax:*"
      ]
    }
  ]
}
