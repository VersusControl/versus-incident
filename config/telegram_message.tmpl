{{/* 
  Universal Telegram Alert Template
  Supports: Alertmanager, Grafana, Sentry, Fluent Bit, CloudWatch
*/}}

{{/* Helper Variables */}}
{{- $defaultRunbook := or (env "DEFAULT_RUNBOOK_URL") "" -}}
{{- $severityIcons := dict "CRITICAL" "🔴" "ERROR" "🟠" "WARNING" "🟡" "INFO" "ℹ️" "RESOLVED" "✅" -}}
{{- $statusIcons := dict "FIRING" "🔥" "RESOLVED" "✅" "UNKNOWN" "ℹ️" -}}

{{/* Detect Source System */}}
{{- $source := "Unknown" -}}
{{- $rootAnnotations := or .commonAnnotations dict -}}
{{- $firstAlert := or (index .alerts 0) dict -}}
{{- $rootK8s := or .kubernetes dict -}}
{{- $rootEvent := or .event dict -}}
{{- $rootIssue := or (or .data dict).issue dict -}}
{{- if and .receiver -}}
  {{- if or $rootAnnotations.dashboardURL $firstAlert.dashboardURL -}}
    {{- $source = "Grafana" -}}
  {{- else -}}
    {{- $source = "Prometheus" -}}
  {{- end -}}
{{- else if .AlarmName -}}
  {{- $source = "CloudWatch" -}}
{{- else if or .log $rootK8s.pod_name -}}
  {{- $source = "Fluent Bit" -}}
{{- else if or $rootEvent.event_id $rootIssue.id -}}
  {{- $source = "Sentry" -}}
{{- end -}}

{{/* Process Alerts */}}
{{- $alerts := list -}}
{{- if or (eq $source "Prometheus") (eq $source "Grafana") -}}
  {{- $alerts = .alerts -}}
{{- else -}}
  {{- $alerts = list . -}} {{/* Treat single payload as one alert */}}
{{- end -}}

{{- range $index, $alert := $alerts -}}
  {{- $labels := or $alert.labels dict -}}
  {{- $annotations := or $alert.annotations dict -}}
  {{- $trigger := or $alert.Trigger dict -}}
  {{- $k8s := or $alert.kubernetes dict -}}
  {{- $k8sLabels := or $k8s.labels dict -}}
  {{- $issue := or (or $alert.data dict).issue dict -}}
  {{- $issueProject := or $issue.project dict -}}
  {{- $issueMeta := or $issue.metadata dict -}}
  {{- $event := or $alert.event dict -}}
  {{- $eventLog := or $event.logentry dict -}}
  {{/* Initialize unified alert data structure */}}
  {{- $unified := dict 
    "SourceSystem" $source 
    "Severity" "INFO" 
    "Status" "UNKNOWN" 
    "Title" "Unknown Alert" 
    "Resource" "N/A" 
    "Description" "No description." 
    "Timestamp" (now | format "2006-01-02 15:04:05")
    "DiagnosticLink" ""
    "RunbookLink" $defaultRunbook
  -}}

  {{/* Map severity based on alert type */}}
  {{- $rawSeverity := "" -}}
  {{- if eq $source "Prometheus" -}}
    {{- $rawSeverity = or $labels.severity "info" -}}
  {{- else if eq $source "Grafana" -}}
    {{- $rawSeverity = or $labels.severity "info" -}}
  {{- else if eq $source "CloudWatch" -}}
    {{- $rawSeverity = or $alert.NewStateValue "info" -}}
  {{- else if eq $source "Fluent Bit" -}}
    {{- $rawSeverity = or $alert.level "info" -}}
  {{- else if eq $source "Sentry" -}}
    {{- $rawSeverity = or $issue.level $event.level "info" -}}
  {{- end -}}

  {{/* Convert severity to standard format */}}
  {{- $severity := lower $rawSeverity -}}
  {{- $mappedSeverity := "INFO" -}}
  {{- if or (eq $severity "critical") (eq $severity "fatal") (eq $severity "alarm") (eq $severity "p1") (eq $severity "1") -}}
    {{- $mappedSeverity = "CRITICAL" -}}
  {{- else if or (eq $severity "error") (eq $severity "high") (eq $severity "p2") (eq $severity "2") -}}
    {{- $mappedSeverity = "ERROR" -}}
  {{- else if or (eq $severity "warning") (eq $severity "warn") (eq $severity "p3") (eq $severity "3") -}}
    {{- $mappedSeverity = "WARNING" -}}
  {{- else if or (eq $severity "ok") (eq $severity "resolved") -}}
    {{- $mappedSeverity = "RESOLVED" -}}
  {{- end -}}

  {{/* Map status based on alert type */}}
  {{- $rawStatus := "" -}}
  {{- if eq $source "Prometheus" -}}
    {{- $rawStatus = or $alert.status "unknown" -}}
  {{- else if eq $source "Grafana" -}}
    {{- $rawStatus = or $alert.status "unknown" -}}
  {{- else if eq $source "CloudWatch" -}}
    {{- $rawStatus = or $alert.NewStateValue "unknown" -}}
  {{- else if eq $source "Fluent Bit" -}}
    {{- $rawStatus = or $alert.level "unknown" -}}
  {{- else if eq $source "Sentry" -}}
    {{- $rawStatus = or $alert.action "unknown" -}}
  {{- end -}}

  {{/* Convert status to standard format */}}
  {{- $status := lower $rawStatus -}}
  {{- $mappedStatus := "UNKNOWN" -}}
  {{- if or (eq $status "firing") (eq $status "alarm") (eq $status "active") (eq $status "unresolved") (eq $status "created") (eq $status "triggered") -}}
    {{- $mappedStatus = "FIRING" -}}
  {{- else if or (eq $status "resolved") (eq $status "ok") (eq $status "completed") -}}
    {{- $mappedStatus = "RESOLVED" -}}
  {{- end -}}

  {{/* Source-Specific Data Extraction */}}
  {{- if eq $source "Prometheus" -}}
    {{/* Extract Prometheus specific fields */}}
    {{- $unified = dict 
      "SourceSystem" $source
      "Severity" $mappedSeverity
      "Status" $mappedStatus
      "Title" (or $labels.alertname "Prometheus Alert") 
      "Resource" (or $labels.instance $labels.pod $labels.job "N/A") 
      "Description" (or $annotations.description $annotations.message $annotations.summary "No description.") 
      "Timestamp" (or $alert.startsAt (now | format "2006-01-02 15:04:05")) 
      "DiagnosticLink" (or $alert.generatorURL "") 
      "RunbookLink" (or $annotations.runbook_url $defaultRunbook)
    -}}

  {{- else if eq $source "Grafana" -}}
    {{/* Extract Grafana specific fields */}}
    {{- $unified = dict 
      "SourceSystem" $source
      "Severity" $mappedSeverity
      "Status" $mappedStatus
      "Title" (or $labels.alertname $annotations.summary $annotations.title "Grafana Alert") 
      "Resource" (or $labels.instance $labels.pod $labels.job $labels.host "N/A") 
      "Description" (or $annotations.description $annotations.message "No description.") 
      "Timestamp" (or $alert.startsAt (now | format "2006-01-02 15:04:05")) 
      "DiagnosticLink" (or $alert.panelURL $alert.dashboardURL $alert.generatorURL "") 
      "RunbookLink" (or $annotations.runbook_url $defaultRunbook)
    -}}

  {{- else if eq $source "CloudWatch" -}}
    {{/* Extract AWS CloudWatch specific fields */}}
    
    {{/* Extract dimensions from the Trigger.Dimensions array */}}
    {{- $formattedDimensions := "" -}}
    {{- $metricNamespace := or $trigger.Namespace "AWS" -}}
    {{- $metricName := or $trigger.MetricName "Unknown" -}}
    
    {{- if $trigger.Dimensions -}}
      {{- $dimensionsList := list -}}
      
      {{/* Loop through each dimension in the array */}}
      {{- range $dimension := $trigger.Dimensions -}}
        {{- if and $dimension.name $dimension.value -}}
          {{- $dimensionsList = append $dimensionsList (printf "%s: %s" $dimension.name $dimension.value) -}}
        {{- end -}}
      {{- end -}}
      
      {{- if $dimensionsList -}}
        {{- $formattedDimensions = join (stringSlice $dimensionsList) ", " -}}
      {{- end -}}
    {{- end -}}
    
    {{/* Format resource string */}}
    {{- $resource := "N/A" -}}
    {{- if $formattedDimensions -}}
      {{- $resource = printf "%s/%s (%s)" $metricNamespace $metricName $formattedDimensions -}}
    {{- else -}}
      {{- $resource = printf "%s/%s" $metricNamespace $metricName -}}
    {{- end -}}
    
    {{/* Extract region code for AWS console link */}}
    {{- $arn := toString (or $alert.AlarmArn "") -}}
    {{- $arnParts := split $arn ":" -}}
    {{- $regionCode := "us-east-1" -}}
    {{- if gt (len $arnParts) 3 -}}
      {{- if regexMatch "^[a-z]{2}(-[a-z]+)+-[0-9]+$" (index $arnParts 3) -}}
        {{- $regionCode = index $arnParts 3 -}}
      {{- end -}}
    {{- end -}}


    
    {{/* Create proper AWS console diagnostic link */}}
    {{- $diagnosticLink := printf "https://%s.console.aws.amazon.com/cloudwatch/home?region=%s#alarmsV2:alarm/%s" $regionCode $regionCode (replace (urlquery (toString $alert.AlarmName)) "+" "%20") -}}
    
    {{- $unified = dict 
      "SourceSystem" $source
      "Severity" $mappedSeverity
      "Status" $mappedStatus
      "Title" (or $alert.AlarmName "CloudWatch Alert") 
      "Resource" $resource
      "Description" (or $alert.NewStateReason "No description.") 
      "Timestamp" (or $alert.StateChangeTime (now | format "2006-01-02 15:04:05")) 
      "DiagnosticLink" $diagnosticLink
      "RunbookLink" $defaultRunbook
      "AWSAccount" (or $alert.AWSAccountId "")
      "AWSRegion" $regionCode
    -}}

  {{- else if eq $source "Fluent Bit" -}}
    {{- $logText := toString (or $alert.log "") -}}
    {{/* Extract Fluent Bit specific fields */}}
    
    {{/* Detect severity from log content */}}
    {{- $detectedSeverity := "INFO" -}}
    {{- if and $logText (regexMatch "(?i)CRITICAL" $logText) -}}
      {{- $detectedSeverity = "CRITICAL" -}}
    {{- else if and $logText (regexMatch "(?i)ERROR" $logText) -}}
      {{- $detectedSeverity = "ERROR" -}}
    {{- else if and $logText (regexMatch "(?i)WARNING" $logText) -}}
      {{- $detectedSeverity = "WARNING" -}}
    {{- end -}}
    
    {{/* Extract Kubernetes metadata if available */}}
    {{- $podResource := "unknown" -}}
    {{- if $k8s -}}
      {{- $podName := or $k8s.pod_name "unknown-pod" -}}
      {{- $namespace := or $k8s.namespace_name "unknown-namespace" -}}
      {{- $containerName := or $k8s.container_name "unknown-container" -}}
      {{- $podResource = printf "pod/%s (container: %s) in namespace %s" $podName $containerName $namespace -}}
    {{- end -}}
    
    {{/* Format timestamp properly */}}
    {{- $timestamp := "" -}}
    {{- if $alert.time -}}
      {{- $timestamp = $alert.time -}}
    {{- else if $alert.date -}}
      {{/* Convert Unix timestamp to formatted time if needed */}}
      {{- $timestamp = $alert.date | toString -}}
    {{- else -}}
      {{- $timestamp = now | format "2006-01-02 15:04:05" -}}
    {{- end -}}
    
    {{/* Extract application from labels if available */}}
    {{- $appName := "unknown" -}}
    {{- if and $k8s $k8sLabels $k8sLabels.app -}}
      {{- $appName = $k8sLabels.app -}}
    {{- end -}}
    
    {{/* Extract error details */}}
    {{- $errorMessage := or $logText "No description." -}}
    {{- $shortError := $logText -}}
    {{- if contains $shortError "\n" -}}
      {{- $lines := split $shortError "\n" -}}
      {{- $shortError = index $lines 0 -}}
    {{- end -}}
    
    {{- $unified = dict 
      "SourceSystem" $source
      "Severity" $detectedSeverity
      "Status" "FIRING"
      "Title" (printf "Error in %s" $appName)
      "Resource" $podResource
      "Description" $errorMessage
      "Timestamp" $timestamp
      "DiagnosticLink" ""
      "RunbookLink" $defaultRunbook
      "K8s" (dict
        "Namespace" (or $k8s.namespace_name "")
        "PodName" (or $k8s.pod_name "")
        "ContainerName" (or $k8s.container_name "")
        "Node" (or $k8s.host "")
        "Labels" (or $k8sLabels dict)
      )
    -}}

  {{- else if eq $source "Sentry" -}}
    {{/* Extract Sentry specific fields */}}
    {{- $unified = dict 
      "SourceSystem" $source
      "Severity" $mappedSeverity
      "Status" $mappedStatus
      "Title" (or $issue.title $alert.message $event.title "Sentry Alert") 
      "Resource" (printf "%s/%s" (or $alert.project_slug $issueProject.slug "unknown") (or $issue.culprit $alert.culprit "N/A")) 
      "Description" (or $issueMeta.value $eventLog.formatted "No description.") 
      "Timestamp" (or $issue.firstSeen $event.timestamp (now | format "2006-01-02 15:04:05")) 
      "DiagnosticLink" (or $issue.web_url $alert.url "") 
      "RunbookLink" $defaultRunbook
    -}}
  {{- end -}}

  {{/* Output Generation (HTML for Telegram) */}}
  {{- $severityIcon := or (index $severityIcons $unified.Severity) "ℹ️" -}}
  {{- $statusIcon := or (index $statusIcons $unified.Status) "ℹ️" -}}
  {{- /* Telegram rejects messages over 4096 characters, so long descriptions are cut before escaping */ -}}
  {{- $description := toString $unified.Description -}}
  {{- if gt (len $description) 3000 -}}
    {{- $description = printf "%s…" (truncate $description 3000) -}}
  {{- end -}}

  {{- /* Start of message output */ -}}
  <b>{{ $statusIcon }} {{ $unified.Status }}: {{ escapeHTML $unified.Title }} ({{ $unified.SourceSystem }})</b>
  
  <b>{{ $severityIcon }} Severity:</b> {{ $unified.Severity }}
  <b>Resource:</b> {{ escapeHTML $unified.Resource }}
  <b>Description:</b> {{ escapeHTML $description }}
  <b>Time:</b> {{ escapeHTML $unified.Timestamp }}
  
  {{- if $unified.AWSAccount }}
  <b>AWS Account:</b> {{ escapeHTML $unified.AWSAccount }}
  {{- end }}
  {{- if $unified.AWSRegion }}
  <b>AWS Region:</b> {{ escapeHTML $unified.AWSRegion }}
  {{- end }}
  
  {{- if and (eq $unified.SourceSystem "Fluent Bit") $unified.K8s }}
  <b>Kubernetes Metadata:</b>
  {{- if $unified.K8s.Namespace }}
  • Namespace: {{ escapeHTML $unified.K8s.Namespace }}
  {{- end }}
  {{- if $unified.K8s.PodName }}
  • Pod: {{ escapeHTML $unified.K8s.PodName }}
  {{- end }}
  {{- if $unified.K8s.ContainerName }}
  • Container: {{ escapeHTML $unified.K8s.ContainerName }}
  {{- end }}
  {{- if $unified.K8s.Node }}
  • Node: {{ escapeHTML $unified.K8s.Node }}
  {{- end }}
  {{- if $unified.K8s.Labels }}
  • Labels:
  {{- range $key, $value := $unified.K8s.Labels }}
    - {{ escapeHTML $key }}: {{ escapeHTML $value }}
  {{- end }}
  {{- end }}
  {{- end }}
  
  {{- if $unified.RunbookLink }}
  <b>Runbook:</b> <a href="{{ escapeHTML $unified.RunbookLink }}">Link</a>
  {{- end }}
  {{- if $unified.DiagnosticLink }}
  <b>Diagnostics:</b> <a href="{{ escapeHTML $unified.DiagnosticLink }}">Link</a>
  {{- end }}
  {{- if $alert.AckURL }}
  -------------------
  <a href="{{ escapeHTML $alert.AckURL }}">Click here to acknowledge</a>
  {{- end }}
  {{- if ne (add $index 1) (len $alerts) }}
  ---
  {{- end }}
{{- end -}}